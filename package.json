{
	"name": "new-jazza",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"images": "tsx images.ts",
		"submodule": "git submodule init && git submodule update",
		"uppies": "pnpm up --latest",
		"gen": "wrangler types",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.1",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@types/color": "^4.2.1",
		"@types/eslint": "^9.6.1",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/filesystem": "^0.0.36",
		"@types/node": "^25.6.0",
		"@types/three": "^0.181.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"prettier": "^3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"sharp": "^0.34.5",
		"svelte": "5.55.3",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.8",
		"vitest": "^4.1.4",
		"wrangler": "^4.82.2"
	},
	"type": "module",
	"dependencies": {
		"@threlte/core": "8.3.0",
		"@threlte/extras": "9.7.1",
		"color": "^5.0.3",
		"detect-gpu": "^5.0.70",
		"three": "^0.181.2"
	},
	"resolutions": {
		"esbuild": "^0.25.0",
		"cookie": "^1.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		],
		"updateConfig": {
			"ignoreDependencies": [
				"@threlte/core",
				"@threlte/extras",
				"three",
				"@types/three"
			]
		},
		"overrides": {
			"postcss@<8.5.10": ">=8.5.10",
			"svelte@>=5.46.0 <=5.55.6": ">=5.55.7",
			"ws@>=8.0.0 <8.20.1": ">=8.20.1",
			"@sveltejs/kit@>=2.38.0 <=2.60.0": ">=2.60.1",
			"brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
			"svelte@<=5.55.6": ">=5.55.7",
			"svelte@>=5.51.5 <=5.55.6": ">=5.55.7",
			"devalue@>=5.6.3 <=5.8.0": ">=5.8.1",
			"ws@>=8.0.0 <8.21.0": ">=8.21.0",
			"vite@>=8.0.0 <=8.0.15": ">=8.0.16",
			"undici@>=7.23.0 <7.28.0": ">=7.28.0",
			"undici@>=7.0.0 <7.28.0": ">=7.28.0"
		}
	}
}